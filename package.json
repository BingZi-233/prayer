{
  "name": "prayer",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "node --experimental-transform-types scripts/ingest.ts",
    "pm:start": "next build && pm2 start ecosystem.config.cjs",
    "pm:stop": "pm2 stop prayer",
    "pm:restart": "pm2 stop prayer && next build && pm2 start prayer --update-env",
    "pm:status": "pm2 status prayer",
    "pm:logs": "pm2 logs prayer",
    "pm:delete": "pm2 delete prayer",
    "pm:enable": "sudo env PATH=$PATH:$(dirname $(command -v node)) $(pnpm bin)/pm2 startup systemd -u $USER --hp $HOME && pm2 save",
    "pm:disable": "sudo env PATH=$PATH:$(dirname $(command -v node)) $(pnpm bin)/pm2 unstartup systemd -u $USER --hp $HOME"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.259",
    "@hookform/resolvers": "^5.9.1",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@shadcn/react": "^0.2.1",
    "@tanstack/react-virtual": "^3.14.10",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "grammy": "^1.46.0",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.20.1",
    "sonner": "^2.0.8",
    "sqlite-vec": "^0.1.9",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "pm2": "^7.0.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
