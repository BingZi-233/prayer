# Prayer 品牌与客服身份（可按部署方白标）
BRAND_NAME=Prayer
BRAND_DESCRIPTION=多渠道 AI 客服中台

# 模型、Anthropic-compatible endpoint 与凭证统一配置在
# CLAUDE_CONFIG_DIR/settings.json，不放入本文件。

# OneBot(NapCat 正向 WS server)
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=
BOT_QQ=10000
# 额外监听 AT 的 QQ(逗号分隔)。群友 @ 这些人时也当 @bot 处理
# EXTRA_AT_QQS=20001,20002
ADMIN_GROUP_ID=20000
HANDOFF_TIMEOUT_MIN=30

# 存储
DB_PATH=./data/agent.db

# 会话:空闲超时(ms)后不 resume,下条消息开全新对话。默认 300000(5 分钟)
# RESUME_TTL_MS=300000

# 知识库预检索:每轮消息进模型前自动检索并注入片段(默认开,设 false 退回纯 kb_search)
# KB_PREFETCH_ENABLED=true
# KB_PREFETCH_TOP_K=5
# 向量 L2 距离上限,越大越宽松;1.0 约等于余弦相似度 0.5
# KB_PREFETCH_MAX_DISTANCE=1.0

# 反思扫描/窗口(均可在管理页改,env 仅作首次种子)
# REFLECT_SCAN_MS=300000
# REFLECT_LOOKBACK_MS=7200000
# REFLECT_SETTLE_MS=600000
# REFLECT_WINDOW_MAX=60
# 反思压缩:周期与最小条数(默认 1h / 10 条)
# REFLECT_COMPACT_MS=3600000
# REFLECT_COMPACT_MIN_ENTRIES=10
# 自动升格:周期 / 最少候选 / 单轮上限(默认 24h / 1 / 5;设 REFLECT_PROMOTE_MS=0 关闭)
# REFLECT_PROMOTE_MS=86400000
# REFLECT_PROMOTE_MIN_ENTRIES=1
# REFLECT_PROMOTE_MAX_PER_RUN=5
# 反思:沉淀/整理后是否通知管理群(默认 true;设 false 静默写入知识库)
# REFLECT_NOTIFY_ADMIN=true

# 主动回复(无人应答兜底):默认关。开启后,生效群内用户提问超 PROACTIVE_SILENCE_MS 无人工/无 @bot 应答,bot 主动补位
PROACTIVE_ENABLED=false
PROACTIVE_SCAN_MS=60000
PROACTIVE_SILENCE_MS=180000
PROACTIVE_MAX_PER_SCAN=2
# 每轮最多进入判定/生成的候选数(1-50,且不低于 MAX_PER_SCAN)
PROACTIVE_CANDIDATE_BUDGET=12

# 管理后台鉴权:开发可省略；生产必填，否则 /admin 与 /api fail-closed
# ADMIN_TOKEN=change-me
# 额外 MCP 工具白名单(逗号/空格分隔，必须是完整 mcp__server__tool 名称；默认仅 CS/Packy 查询)
# PRAYER_MCP_ALLOWLIST=mcp__plugin_example_example__read_status
# 仅在可信反向代理会覆盖/规范化转发头时启用；否则登录限速统一使用 unknown 桶
# TRUST_PROXY=false
# 可选：把显式备份路径加入权限审计（逗号/空格分隔；不会递归扫描目录）
# PRAYER_BACKUP_PATHS=./data/backups/agent.db.bak

# 办不了事务时引导链接
# SUPPORT_URL=

# @ 后 ACK(默认开;设 false 关闭)
# ACK_ENABLED=true

# 单条回复字数上限,超出拆条(0=不拆)
# MAX_REPLY_CHARS=900

# 日用量预算 USD,超阈告警管理群(0=不告警)
# USAGE_BUDGET_USD=0
